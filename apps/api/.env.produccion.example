# Perfil produccion: ensayo local de la base oficial (planificacion_turnos).
# Es la misma base que luego se instala en el servidor del hospital, probada
# primero en esta PC. NO se puede resetear ni sembrar (reset:db, seed:system y
# seed:institution se niegan a proposito): se llena restaurando un backup de
# preparacion (npm run restore:api). La sincronizacion de personal con el RRHH externo y
# las migraciones nuevas (npm run migrate:api) si funcionan aqui.
# Copiar como apps/api/.env.produccion (fuera de git) y completar usuario y
# contrasena. Activar: npm run env:produccion.
# Lo que no aparece aqui usa el valor por defecto del codigo (ver .env.example).
#
# Conexion: usar UNA de las dos formas.
#   Por puerto (recomendado): DB_PORT=<puerto TCP fijo> y DB_INSTANCE vacio.
#     No depende del servicio SQL Browser; en el firewall basta abrir ese puerto.
#   Por instancia: DB_INSTANCE=<nombre, ej. SQL2008R2> y DB_PORT vacio.
#     Requiere el servicio SQL Browser activo (y el puerto UDP 1434 si es remoto).
#   Si se definen ambos, gana el puerto y la instancia se ignora.
# Servidor en otra PC: DB_HOST=<IP o nombre del servidor>.
DB_HOST=localhost
DB_INSTANCE=
DB_PORT=1435
DB_NAME=planificacion_turnos
DB_USER=usuario
DB_PASSWORD=password
DB_PROFILE=mssql-2008r2
DB_COMPATIBILITY_LEVEL=100

# Instancia remota y mas lenta que la local: mas margen de conexion y consulta.
DB_CONNECT_TIMEOUT_MS=10000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MAX=5

CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Distinto al de preparacion y al del servidor del hospital.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
EXPORT_INSTITUTION_NAME=Hospital de Ejemplo

# Sistema de RRHH externo (solo lectura). Ver .env.example para las 4 combinaciones de ubicacion/credenciales.
RRHH_DB_SERVIDOR=MISMA_INSTANCIA
RRHH_DB_CREDENCIALES=MISMAS
RRHH_DB_NAME=RRHH
# Politica de prueba: las personas validas se crean activas. Revisar antes de produccion.
SYNC_PERSONAL_DEFAULT_ACTIVE=true
