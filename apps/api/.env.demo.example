# Perfil demo: datos ficticios basicos para presentar o desarrollar.
# Copiar como apps/api/.env.demo (fuera de git) y completar usuario y contrasena.
# Activar: npm run env:demo. Cargar datos: npm run migrate:api && npm run seed:demo.
# Lo que no aparece aqui usa el valor por defecto del codigo (ver .env.example).
DB_HOST=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_NAME=roles_turnos_demo
DB_USER=usuario
DB_PASSWORD=password

CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
