# Referencia de TODAS las variables de la API. No se usa directamente.
#
# Perfiles de desarrollo (docs/deployment/guia-perfiles-entorno.md):
#   demo      -> copiar .env.demo.example a .env.demo           (datos ficticios)
#   preparacion -> copiar .env.preparacion.example a .env.preparacion (copia de trabajo, datos reales + RRHH externo)
#   produccion  -> copiar .env.produccion.example a .env.produccion (ensayo local de la base oficial)
#   activar con: npm run env:demo | npm run env:preparacion | npm run env:produccion
# Servidor real (sin perfiles): copiar .env.production.example a .env.
#
# Las variables comentadas tienen valor por defecto en el codigo; definirlas
# solo si el entorno necesita otro valor.

# --- Obligatorias ---
DB_HOST=localhost
# Instancia con nombre o puerto fijo; si hay DB_PORT, DB_INSTANCE se ignora.
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_NAME=roles_turnos_demo
DB_USER=usuario
DB_PASSWORD=password
# Secreto de firma de los tokens de sesion (JWT). Unico por entorno; en
# produccion, un valor largo y aleatorio, nunca el mismo que en desarrollo.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# --- Perfil de compatibilidad SQL Server ---
# mssql-modern (por defecto) o mssql-2008r2. El nivel por defecto es 160 o 100.
# DB_PROFILE=mssql-modern
# DB_COMPATIBILITY_LEVEL=160

# --- Conexion (valores por defecto en database-env.ts) ---
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true
# DB_CONNECT_MAX_RETRIES=5
# DB_CONNECT_RETRY_DELAY_MS=3000
# Solo el handshake de conexion; distinto de DB_REQUEST_TIMEOUT_MS.
# DB_CONNECT_TIMEOUT_MS=5000
# Ejecucion de una consulta con la conexion ya establecida.
# DB_REQUEST_TIMEOUT_MS=15000
# Tamano maximo del pool de conexiones TypeORM.
# DB_POOL_MAX=10
# Espera maxima por una conexion libre del pool.
# DB_POOL_ACQUIRE_TIMEOUT_MS=10000

# --- Servidor HTTP ---
# Obligatoria en produccion (cors-env.ts).
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# CORS_CREDENTIALS=false
# PORT=3000
# HOST=0.0.0.0
# development | production (CORS estricto y reporte de /health/database).
# NODE_ENV=development

# --- Exportaciones (opcional; docs/exportacion/plantillas-excel-rol-turnos.md) ---
# Sin configurar usa un encabezado generico.
# EXPORT_INSTITUTION_NAME=Hospital de Ejemplo
# Lineas adicionales del encabezado, separadas por "|".
# EXPORT_INSTITUTION_HEADER_LINES=

# --- Sistema de RRHH externo (solo lectura; consulta en database/integracion/rrhh-externo/) ---
# Solo necesario para npm run sync:personal:*. Dos decisiones independientes:
#   RRHH_DB_SERVIDOR     MISMA_INSTANCIA -> usa DB_HOST/DB_INSTANCE/DB_PORT (no definir RRHH_DB_HOST/INSTANCE/PORT)
#                          PROPIA          -> exige RRHH_DB_HOST (+ INSTANCE o PORT)
#   RRHH_DB_CREDENCIALES MISMAS          -> usa DB_USER/DB_PASSWORD (no definir RRHH_DB_USER/PASSWORD)
#                          PROPIAS         -> exige RRHH_DB_USER y RRHH_DB_PASSWORD (recomendado: usuario de solo lectura)
# Nunca usar estas variables para apuntar la conexion principal de la app.
# RRHH_DB_SERVIDOR=MISMA_INSTANCIA
# RRHH_DB_CREDENCIALES=PROPIAS
# RRHH_DB_NAME=RRHH
# RRHH_DB_USER=
# RRHH_DB_PASSWORD=
# Solo con RRHH_DB_SERVIDOR=PROPIA:
# RRHH_DB_HOST=
# RRHH_DB_INSTANCE=
# RRHH_DB_PORT=
# RRHH_DB_ENCRYPT=false
# RRHH_DB_TRUST_SERVER_CERTIFICATE=true
# RRHH_DB_CONNECT_TIMEOUT_MS=5000
# RRHH_DB_REQUEST_TIMEOUT_MS=15000
# Personas validas se crean activas (true, por defecto) o inactivas (false).
# SYNC_PERSONAL_DEFAULT_ACTIVE=true
