# Servidor real de una institucion: copiar como apps/api/.env en el servidor.
# En produccion no se usan perfiles (no ejecutar npm run env:*): se carga este
# .env o, con prioridad, las variables de entorno del sistema.
# Lo que no aparece aqui usa el valor por defecto del codigo (ver .env.example).
NODE_ENV=production
# Conexion: usar UNA de las dos formas (si estan ambas, gana el puerto).
#   Por puerto (recomendado): DB_PORT=<puerto TCP fijo> y DB_INSTANCE vacio.
#   Por instancia: DB_INSTANCE=<nombre> y DB_PORT vacio (requiere SQL Browser).
DB_HOST=sqlserver-host
DB_INSTANCE=
DB_PORT=1433
# Mismo nombre que la base oficial ensayada en la PC (perfil produccion).
DB_NAME=planificacion_turnos
DB_USER=change_me
DB_PASSWORD=change_me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
# mssql-modern (SQL Server 2012 o superior) o mssql-2008r2. Una base restaurada
# desde un backup de 2008 R2 conserva su nivel de compatibilidad (100): usar
# mssql-2008r2 salvo que se suba ese nivel. npm run doctor avisa si no coincide.
DB_PROFILE=mssql-2008r2

# Obligatoria en produccion: URL publica del frontend.
CORS_ORIGINS=https://roles-turnos.institucion.local
# Secreto de firma de los tokens de sesion (JWT). Obligatorio, valor largo y
# aleatorio, unico por entorno; nunca reutilizar el de desarrollo.
JWT_SECRET=change_me

EXPORT_INSTITUTION_NAME=
EXPORT_INSTITUTION_HEADER_LINES=

# Sistema de RRHH externo (solo si la institucion sincroniza personal). Recomendado: usuario de
# solo lectura propio. Ver .env.example para las 4 combinaciones.
# RRHH_DB_SERVIDOR=MISMA_INSTANCIA
# RRHH_DB_CREDENCIALES=PROPIAS
# RRHH_DB_NAME=RRHH
# RRHH_DB_USER=
# RRHH_DB_PASSWORD=
# Decision pendiente con la institucion: si las personas nuevas entran activas
# (true, por defecto) o inactivas hasta confirmarlas (false).
# SYNC_PERSONAL_DEFAULT_ACTIVE=
